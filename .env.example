# Copy to .env.local and fill in. Next.js loads .env.local for every command,
# so whichever values are in it decide which database you are developing
# against. See supabase/README.md for the two supported setups.

# ─── Supabase ────────────────────────────────────────────────
#
# Option A — hosted project (current default).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=eyJhbGci...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...
#
# Option B — local stack. Run `npm run db:start` and copy the values it prints
# (`npm run db:status` reprints them). The URL is stable; the keys are derived
# from the JWT secret in supabase/config.toml and only work against localhost.
#
#   NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
#   NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<from db:start>
#   SUPABASE_SERVICE_ROLE_KEY=<from db:start>

# Which hosted project `npm run db:link` targets. Optional — defaults to the
# production ref. Set it to link a checkout to a different project.
# SUPABASE_PROJECT_REF=

# ─── Anthropic (pattern PDF extraction) ──────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ─── ElevenLabs (read-aloud in Follow Mode) ─────────────────
# Optional — without it the read-aloud controls are hidden.
ELEVENLABS_API_KEY=sk_...
# Optional. The voice used until a knitter picks one in Follow Mode. Defaults
# to "Alice"; any voice ID from your ElevenLabs library works.
# ELEVENLABS_VOICE_ID=Xb7hH8MSUJpSbSDYk0k2

# ─── Ravelry API ─────────────────────────────────────────────
# Only needed to run the yarn import script against the hosted catalog. Local
# development uses supabase/seed.sql instead, so you can leave these unset.
# RAVELRY_USERNAME=
# RAVELRY_PASSWORD=
